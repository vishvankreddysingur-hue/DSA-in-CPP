class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int max = nums[0];

        // Find the largest element
        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] > max) {
                max = nums[i];
            }
        }

        int max2 = -1;
        bool skipped = false;

        // Find the second largest element
        for (int j = 0; j < nums.size(); j++) {
            if (nums[j] == max && !skipped) {
                skipped = true;
                continue;
            }

            if (nums[j] > max2) {
                max2 = nums[j];
            }
        }

        return (max - 1) * (max2 - 1);
    }
};
